# Copy to .env and adjust. Every value below is a placeholder.

# "local" runs fully offline (hashing embeddings + extractive answers).
# "azure" uses Azure OpenAI for both embeddings and chat.
LLM_PROVIDER=local

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Retrieval
DATA_DIR=data
INDEX_DIR=.index
TOP_K=5
# Leave empty to use the embedder's calibrated default (see README, "Why a score threshold").
MIN_SCORE=
CHUNK_SIZE=800
CHUNK_OVERLAP=120
